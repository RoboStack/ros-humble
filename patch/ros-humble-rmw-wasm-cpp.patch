--- a/rmw_wasm_cpp/CMakeLists.txt	2026-09-08 18:31:13
+++ b/rmw_wasm_cpp/CMakeLists.txt	2026-09-08 18:31:45
@@ -29,11 +29,36 @@
 find_package(rosidl_runtime_cpp REQUIRED)
 find_package(rosidl_typesupport_introspection_c REQUIRED)
 find_package(rosidl_typesupport_introspection_cpp REQUIRED)
-find_package(BZip2 REQUIRED)
-find_package(SQLite3 REQUIRED)
-find_package(ZLIB REQUIRED)
+# BZip2/SQLite3/ZLIB are find_package()'d and target_link_libraries()'d
+# below but nothing in rmw_wasm_cpp's own sources (src/*.cpp) actually
+# calls into any of them -- dead weight left over from whatever RMW
+# implementation this CMakeLists.txt was originally templated from. On
+# every other platform that's harmless (conda-forge ships all three, so
+# find_package() just succeeds and the unused link entries are inert).
+# Under emscripten it isn't harmless: emscripten-forge's prebuilt
+# libsqlite3.a/libbz2.a static libs weren't compiled with the
+# atomics/bulk-memory wasm features our pthread-enabled build now
+# requires (we have no way to add compile flags to an already-built
+# external static archive), so pulling them into this SIDE_MODULE link
+# fails with "wasm-ld: error: --shared-memory is disallowed by
+# sqlite3.o ... because it was not compiled with 'atomics' or
+# 'bulk-memory' features." Skip them entirely under emscripten instead
+# of trying to rebuild emscripten-forge's own packages with pthread
+# support just to satisfy an unused dependency.
+if(NOT EMSCRIPTEN)
+  find_package(BZip2 REQUIRED)
+  find_package(SQLite3 REQUIRED)
+  find_package(ZLIB REQUIRED)
+endif()
 find_package(PkgConfig REQUIRED)
-pkg_check_modules(libffi REQUIRED libffi)
+if(EMSCRIPTEN)
+  # emscripten-forge's libffi package ships headers and a static lib but no
+  # libffi.pc, so pkg_check_modules() can never find it here (it works fine
+  # on every other platform, where conda-forge's libffi does ship one).
+  find_library(libffi_LINK_LIBRARIES NAMES ffi libffi REQUIRED)
+else()
+  pkg_check_modules(libffi REQUIRED libffi)
+endif()
 
