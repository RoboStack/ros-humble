diff -ruN a/include/qt_gui_cpp/generic_proxy.h b/include/qt_gui_cpp/generic_proxy.h
--- a/include/qt_gui_cpp/generic_proxy.h
+++ b/include/qt_gui_cpp/generic_proxy.h
@@ -35,6 +35,13 @@
 
 #include <QObject>
 
+// Q_ARG/Q_RETURN_ARG now build QMetaMethodArgument/QTemplatedMetaMethodReturnArgument
+// for Qt's templated invokeMethod overloads, which are no longer QGenericArgument/
+// QGenericReturnArgument themselves. This proxy predates that change and still
+// trades in the old generic types, so build those directly instead.
+#define QGC_ARG(Type, data) QArgument<Type>(#Type, data)
+#define QGC_RETURN_ARG(Type, data) QGenericReturnArgument(#Type, static_cast<void*>(&(data)))
+
 namespace qt_gui_cpp
 {
 
