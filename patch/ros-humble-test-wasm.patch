--- a/test_wasm/CMakeLists.txt	2026-09-08 15:05:16
+++ b/test_wasm/CMakeLists.txt	2026-09-08 15:05:16
@@ -41,4 +41,35 @@
   DESTINATION lib/${PROJECT_NAME}
 )
 
+# install(TARGETS ...) only installs the primary executable output (the
+# .html shell, per CMAKE_EXECUTABLE_SUFFIX above) -- it does not know
+# about the .js glue code and .wasm binary em++ generates alongside it,
+# so those never made it into the package at all (confirmed: only the
+# four .html files existed under lib/test_wasm/, and every one 404'd
+# trying to fetch its own <name>.js at runtime).
+install(
+  FILES
+    ${CMAKE_CURRENT_BINARY_DIR}/talker.js
+    ${CMAKE_CURRENT_BINARY_DIR}/talker.wasm
+    ${CMAKE_CURRENT_BINARY_DIR}/listener.js
+    ${CMAKE_CURRENT_BINARY_DIR}/listener.wasm
+    ${CMAKE_CURRENT_BINARY_DIR}/server.js
+    ${CMAKE_CURRENT_BINARY_DIR}/server.wasm
+    ${CMAKE_CURRENT_BINARY_DIR}/client.js
+    ${CMAKE_CURRENT_BINARY_DIR}/client.wasm
+  DESTINATION lib/${PROJECT_NAME}
+)
+
+# emscripten 4.0.9's own generated dylib-loading runtime (the addEmJs()
+# helper embedded in every one of these .js files, used to resolve
+# EM_JS-defined functions from dynamically-loaded .so's) strips only the
+# FIRST "*" from a C parameter type string ("jsArg.replace(\"*\",\"\")",
+# a non-global String.replace), so any EM_JS function with a
+# double-pointer argument leaves one "*" behind in the generated JS
+# parameter name -- "Uncaught SyntaxError: Unexpected token '*'" at
+# startup, before any of our own code ever runs. This is emscripten SDK
+# runtime content, not something in wasm_cpp/rmw_wasm_cpp/our own
+# sources to fix; patch the installed .js files directly.
+install(SCRIPT ${CMAKE_CURRENT_SOURCE_DIR}/fix_addEmJs.cmake)
+
 ament_package()
--- /dev/null
+++ b/test_wasm/fix_addEmJs.cmake	2026-09-08 15:05:16
@@ -0,0 +1,6 @@
+file(GLOB _wasm_cpp_js_files "${CMAKE_INSTALL_PREFIX}/lib/test_wasm/*.js")
+foreach(_wasm_cpp_js_file ${_wasm_cpp_js_files})
+  file(READ "${_wasm_cpp_js_file}" _wasm_cpp_js_content)
+  string(REPLACE [[jsArg.replace("*","")]] [[jsArg.replaceAll("*","")]] _wasm_cpp_js_content "${_wasm_cpp_js_content}")
+  file(WRITE "${_wasm_cpp_js_file}" "${_wasm_cpp_js_content}")
+endforeach()
