   list(APPEND extra_cmake_args "-DYAML_BUILD_SHARED_LIBS=ON")
   list(APPEND extra_cmake_args "-DCMAKE_CXX_COMPILER=${CMAKE_CXX_COMPILER}")
   list(APPEND extra_cmake_args "-DCMAKE_CXX_FLAGS=${CMAKE_CXX_FLAGS}")
+  # yaml-cpp 0.7.0's own cmake_minimum_required predates CMake 3.5, which
+  # CMake >=4.0 (ours is 4.4.3) refuses outright ("Compatibility with
+  # CMake < 3.5 has been removed"). Only reached here on wasm32, where no
+  # conda yaml-cpp package exists and this ExternalProject fallback fires.
+  list(APPEND extra_cmake_args "-DCMAKE_POLICY_VERSION_MINIMUM=3.5")
+  # Without re-propagating vinca's __vinca_shared_lib_patch.cmake (which
+  # sets TARGET_SUPPORTS_SHARED_LIBS TRUE and the emscripten
+  # MAIN_MODULE/SIDE_MODULE linker flags needed for real .so output), this
+  # nested ExternalProject build silently downgrades YAML_BUILD_SHARED_LIBS
+  # to a static libyaml-cppd.a despite the flag above -- Emscripten.cmake's
+  # default is TARGET_SUPPORTS_SHARED_LIBS=FALSE, and CMake add_library()
+  # honors that over the SHARED keyword. A statically-linked yaml-cpp then
+  # gets pulled into multiple final .wasm links (rcl directly, plus
+  # transitively via dynmsg), and unlike a real linker, wasm-ld treats the
+  # same static archive appearing twice as a hard duplicate-symbol error.
+  if(CMAKE_PROJECT_INCLUDE)
+    list(APPEND extra_cmake_args "-DCMAKE_PROJECT_INCLUDE=${CMAKE_PROJECT_INCLUDE}")
+  endif()
 
   if(WIN32 AND NOT ${CMAKE_VERBOSE_MAKEFILE})
     set(should_log ON)  # prevent warnings in Windows CI
