+  # On wasm32, installing under a private opt/yaml_cpp_vendor prefix (as
+  # done for every other platform, to avoid clashing with a real system
+  # yaml-cpp package) leaves the resulting libyaml-cppd.so.0.7.0 outside
+  # every consumer's emscripten -L search path -- em++'s dylink dependency
+  # resolution independently re-resolves each .so's NEEDED entries by name
+  # through -L, it doesn't just trust the full path already on the link
+  # command line. There's no real yaml-cpp package to clash with here
+  # anyway (that's the whole reason this ExternalProject fallback exists),
+  # so install straight into $PREFIX where every other .so already lives.
+  if(EMSCRIPTEN)
+    install(
+      DIRECTORY
+        ${CMAKE_CURRENT_BINARY_DIR}/yaml_cpp_install/
+      DESTINATION
+        ${CMAKE_INSTALL_PREFIX}
+      USE_SOURCE_PERMISSIONS
+    )
+  else()
+    install(
+      DIRECTORY
+        ${CMAKE_CURRENT_BINARY_DIR}/yaml_cpp_install/
+      DESTINATION
+        ${CMAKE_INSTALL_PREFIX}/opt/yaml_cpp_vendor
+      USE_SOURCE_PERMISSIONS
+    )
+  endif()
 endmacro()
 
