-list(APPEND yaml_cpp_vendor_TARGETS yaml-cpp::yaml-cpp)
+# yaml-cpp 0.7.0 (built from source here, since no yaml-cpp conda package
+# exists for wasm32) only exports the plain "yaml-cpp" imported target,
+# not the "yaml-cpp::yaml-cpp" ALIAS added in later releases -- referencing
+# a nonexistent aliased target left consumers silently missing yaml-cpp's
+# include directories (confirmed: wasm_cpp's build compiled fine except
+# "yaml-cpp/yaml.h" file not found once ament_target_dependencies fell
+# through to this target list). Detect whichever target actually exists.
+if(TARGET yaml-cpp::yaml-cpp)
+  set(_yaml_cpp_vendor_real_target yaml-cpp::yaml-cpp)
+elseif(TARGET yaml-cpp)
+  set(_yaml_cpp_vendor_real_target yaml-cpp)
+endif()
+if(_yaml_cpp_vendor_real_target)
+  list(APPEND yaml_cpp_vendor_TARGETS ${_yaml_cpp_vendor_real_target})
+  if(NOT yaml_cpp_vendor_INCLUDE_DIRS)
+    get_target_property(yaml_cpp_vendor_INCLUDE_DIRS ${_yaml_cpp_vendor_real_target} INTERFACE_INCLUDE_DIRECTORIES)
+  endif()
+  if(NOT yaml_cpp_vendor_LIBRARIES)
+    set(yaml_cpp_vendor_LIBRARIES ${_yaml_cpp_vendor_real_target})
+  endif()
+endif()
